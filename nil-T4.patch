index c3fd686..c457104 100644
--- a/pipeline/moonsite/pds.py
+++ b/pipeline/moonsite/pds.py
@@ -89,3 +89,54 @@ class PolarRaster:
         ok = (ii >= 0) & (jj >= 0) & (ii < n) & (jj < m)
